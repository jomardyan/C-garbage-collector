# Make-only output guard. Never permits source or arbitrary configurable paths.
cmake_path(ABSOLUTE_PATH ROOT NORMALIZE OUTPUT_VARIABLE root)
cmake_path(ABSOLUTE_PATH OUTPUT BASE_DIRECTORY "${root}" NORMALIZE OUTPUT_VARIABLE output)
cmake_path(IS_PREFIX root "${output}" NORMALIZE inside)
if(NOT inside OR output STREQUAL root)
  message(FATAL_ERROR "Generated output must stay inside the project")
endif()
file(RELATIVE_PATH relative "${root}" "${output}")
if(NOT relative MATCHES "^(build([-][A-Za-z0-9_.-]+)?|dist)(/|$)")
  message(FATAL_ERROR "Only build, build-* and dist are owned generated output roots: ${relative}")
endif()
set(existing "${output}")
while(NOT EXISTS "${existing}" AND NOT IS_SYMLINK "${existing}")
  cmake_path(GET existing PARENT_PATH parent)
  if(existing STREQUAL parent)
    message(FATAL_ERROR "Cannot resolve output ancestry")
  endif()
  set(existing "${parent}")
endwhile()
file(REAL_PATH "${existing}" physical)
cmake_path(IS_PREFIX root "${physical}" NORMALIZE physical_inside)
if(NOT physical_inside)
  message(FATAL_ERROR "Refusing a junction/symlink outside the project")
endif()
set(current "${output}")
while(NOT current STREQUAL root)
  if(IS_SYMLINK "${current}")
    message(FATAL_ERROR "Refusing symlink output: ${current}")
  endif()
  cmake_path(GET current PARENT_PATH current)
endwhile()
find_program(GIT_EXECUTABLE git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" ls-files -- "${relative}" WORKING_DIRECTORY "${root}" RESULT_VARIABLE result OUTPUT_VARIABLE tracked)
if(NOT result EQUAL 0 OR NOT tracked STREQUAL "")
  message(FATAL_ERROR "Cannot overwrite tracked source: ${relative}")
endif()
if(CLEAN AND EXISTS "${output}")
  file(REMOVE_RECURSE "${output}")
endif()
