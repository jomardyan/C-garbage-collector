if(WIN32)
    set(ENV{PATH} "${GC_LIBRARY_DIR};$ENV{PATH}")
endif()

function(gc_bench_expect expected)
    execute_process(COMMAND "${GC_BENCH_EXECUTABLE}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result STREQUAL "${expected}")
        message(FATAL_ERROR "gc_bench ${ARGN}: expected exit ${expected}, got ${result}\n${output}\n${errors}")
    endif()
    set(bench_output "${output}" PARENT_SCOPE)
endfunction()

if(GC_BENCH_MODE STREQUAL "smoke")
    gc_bench_expect(0 --objects 16 --iterations 1)
    string(REPLACE "\r\n" "\n" bench_output "${bench_output}")
    string(STRIP "${bench_output}" bench_output)
    string(REPLACE "\n" ";" rows "${bench_output}")
    list(LENGTH rows row_count)
    if(NOT row_count EQUAL 6)
        message(FATAL_ERROR "Expected CSV header and five benchmark rows: ${bench_output}")
    endif()
    list(POP_FRONT rows header)
    if(NOT header STREQUAL "workload,objects,iterations,operations,total_ns,median_ns,p95_ns,max_ns,operations_per_second")
        message(FATAL_ERROR "Unexpected benchmark CSV header: ${header}")
    endif()
    set(expected_workloads rooted_allocation linked_graph_retained_collection
        linked_graph_reclaimed_collection array_element_construction weak_registration_and_promotion)
    foreach(row IN LISTS rows)
        string(REPLACE "," ";" fields "${row}")
        list(LENGTH fields field_count)
        if(NOT field_count EQUAL 9)
            message(FATAL_ERROR "Expected nine CSV columns: ${row}")
        endif()
        list(GET fields 0 workload)
        list(FIND expected_workloads "${workload}" workload_index)
        if(workload_index EQUAL -1)
            message(FATAL_ERROR "Unexpected or duplicate workload: ${workload}")
        endif()
        list(REMOVE_ITEM expected_workloads "${workload}")
    endforeach()
elseif(GC_BENCH_MODE STREQUAL "help")
    gc_bench_expect(0 --help)
    if(NOT bench_output MATCHES "Usage: gc_bench")
        message(FATAL_ERROR "Benchmark help must describe CLI usage: ${bench_output}")
    endif()
elseif(GC_BENCH_MODE STREQUAL "invalid")
    gc_bench_expect(2 --unknown)
    gc_bench_expect(2 --objects)
    gc_bench_expect(2 --objects 0)
    gc_bench_expect(2 --iterations -1)
    gc_bench_expect(2 --objects 3x)
    gc_bench_expect(2 --objects 16 --objects 32)
    gc_bench_expect(2 --objects 1000000 --iterations 200)
else()
    message(FATAL_ERROR "Unknown benchmark test mode: ${GC_BENCH_MODE}")
endif()
